#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🚀 Running pre-push checks..."

set -e  # Exit on error

echo "🔍 Linting..."
npm run lint

echo "🧪 Running tests in CI mode..."
npm run test:ci

echo "🏗️ Building project..."
npm run build

echo "✅ All checks passed! Pushing to repository..."

#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔎 Checking staged files for SecondServe/frontend/web changes..."

# Exit immediately if any command fails
set -e

# Get staged files (added, copied, modified)
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACM)"

# Skip if no staged files
if [ -z "$STAGED_FILES" ]; then
  echo "No staged files. Skipping Angular checks."
  exit 0
fi

# Skip if no files under SecondServe/frontend/web were changed
echo "$STAGED_FILES" | grep -E '^SecondServe/frontend/web' >/dev/null 2>&1 || {
  echo "No changes in SecondServe/frontend/web — skipping Angular checks."
  exit 0
}

echo "Changes detected under SecondServe/frontend/web — running Angular checks..."

# Move to Angular directory
cd SecondServe/frontend/web || {
  echo "Failed to enter Angular directory"
  exit 1
}

# Run lint
echo "📝 Running lint..."
npm run lint

# Run tests in CI mode
echo "🧪 Running tests..."
npm run test:ci

echo "✅ Angular pre-commit checks passed!"

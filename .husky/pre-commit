echo "🔎 Checking staged files for proj2/SecondServe changes..."

set -e

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACM)"

if [ -z "$STAGED_FILES" ]; then
  echo "No staged files. Skipping Angular checks."
  exit 0
fi

printf '%s\n' "$STAGED_FILES" | grep -E '^proj2/SecondServe/' >/dev/null || {
  echo "No changes in proj2/SecondServe — skipping Angular checks."
  exit 0
}

echo "Changes detected under proj2/SecondServe — running Angular checks..."
cd proj2/SecondServe || exit 1

echo "📝 Running lint..."
npm run lint

echo "🧪 Running tests..."
npm run test:ci

echo "✅ Angular pre-commit checks passed!"

# Angular checks
echo "🔎 Checking staged files for proj2/SecondServe changes..."

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACM)"

if printf '%s\n' "$STAGED_FILES" | grep -qE '^proj2/SecondServe/frontend/'; then
  echo "Changes detected under Angular — running Angular checks..."
  cd proj2/SecondServe/frontend || exit 1

  echo "📝 Running lint..."
  npm run lint

  echo "🧪 Running tests..."
  npm run test:ci

  echo "✅ Angular pre-commit checks passed!"
else
  echo "No Angular changes — skipping Angular checks."
fi

# Python backend checks
if printf '%s\n' "$STAGED_FILES" | grep -qE '^proj2/SecondServe/backend/'; then
  echo "Changes detected under Python backend — running backend checks..."
  cd proj2/SecondServe/backend || exit 1

  # Activate venv if exists
  if [ -f "venv/bin/activate" ]; then
    . venv/bin/activate
  fi

  echo "📝 Running Python lint..."
  flake8 .

  echo "🧪 Running Python tests..."
  pytest testing

  echo "📚 Generating docs..."
  sphinx-build -b html docs/source docs/build/html

  echo "✅ Python backend pre-commit checks passed!"
else
  echo "No Python backend changes — skipping backend checks."
fi

echo "🔎 Checking staged files for SecondServe/frontend/web changes..."

set -e

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACM)"

if [ -z "$STAGED_FILES" ]; then
  echo "No staged files. Skipping Angular checks."
  exit 0
fi

printf '%s\n' "$STAGED_FILES" | grep -E '^SecondServe/frontend/web' >/dev/null || {
  echo "No changes in SecondServe/frontend/web — skipping Angular checks."
  exit 0
}

echo "Changes detected under SecondServe/frontend/web — running Angular checks..."
cd SecondServe/frontend/web || exit 1

echo "📝 Running lint..."
npm run lint

echo "🧪 Running tests..."
npm run test:ci

echo "✅ Angular pre-commit checks passed!"

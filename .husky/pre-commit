#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Check if --use-docker flag is passed to git commit
USE_DOCKER_HOOKS=true
for arg in "$@"; do
  if [ "$arg" = "--use-docker" ]; then
    USE_DOCKER_HOOKS=true
    break
  fi
done

# Container names (adjust as needed)
FRONTEND_CONTAINER="angular-dev"
BACKEND_CONTAINER="django-backend"

echo "🔍 Pre-commit: Docker flag = $USE_DOCKER_HOOKS"

# Detect staged files
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACM)"

######################################
# FRONTEND CHECKS
######################################
if printf '%s\n' "$STAGED_FILES" | grep -qE '^SecondServe/frontend/'; then
  echo "🧩 Frontend changes detected."

  cd SecondServe/frontend/web || exit 1

  echo "📝 Running lint..."
  npm run lint

  cd ../..

  if [ "$USE_DOCKER_HOOKS" = "true" ]; then
    echo "🐋 Running frontend checks inside Docker..."
    docker exec -i "$FRONTEND_CONTAINER" /bin/sh -c "
      npm run test:coverage &&
      npm run coverage:badge
    " || exit 1
  else
    echo "Frontend tests not run"
  fi

  cd ..

  echo "✅ Frontend checks passed!"
else
  echo "🪶 No frontend changes detected."
fi

######################################
# BACKEND CHECKS
######################################
if printf '%s\n' "$STAGED_FILES" | grep -qE '^SecondServe/backend/'; then
  echo "🧩 Backend changes detected."
  cd SecondServe/backend || exit 1

  # Activate venv if exists
  if [ -f "venv/bin/activate" ]; then
    . venv/bin/activate
  fi

  echo "📝 Running Python lint..."
  black .
  git add .
  flake8 .

  echo "📚 Generating docs..."
  sphinx-apidoc -o docs/source . testing/* mongo_migrations/* docs/* --separate || true
  docstr-coverage User SecondServe --skip-private --skip-magic --badge docs/source/_static/doc_coverage.svg || true
  sphinx-build -b html docs/source docs/build/html || true

  cd ..

  if [ "$USE_DOCKER_HOOKS" = "true" ]; then
    echo "🐋 Running backend checks inside Docker..."
    docker exec -i "$BACKEND_CONTAINER" /bin/sh -c "
      coverage run -m pytest &&
      coverage xml -o coverage.xml && 
      coverage report -m && 
      coverage-badge -o docs/source/_static/test_coverage.svg -f
    " || exit 1
  else
    echo "🧪 Running backend checks locally..."
    cd SecondServe/backend || exit 1
    black . && flake8 . && pytest --maxfail=1 --disable-warnings -q
    cd ../..
  fi

  echo "✅ Backend checks passed!"
else
  echo "🪶 No backend changes detected."
fi
